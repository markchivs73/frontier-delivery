{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/markchivs73/frontier-delivery/contracts/envelopes.schema.json",
  "title": "frontier-delivery handoff envelopes",
  "description": "Machine-checkable form of process/handoffs.md. Validate an envelope against #/$defs/<agent>. The runner validates every envelope; the same schemas become the typed messages on workflow edges when the process runs on Frontier Workflow / MAF.",
  "$defs": {
    "status": { "enum": ["ok", "needs_input", "failed"] },
    "common": {
      "type": "object",
      "required": ["agent", "work_item", "status", "artifacts", "summary"],
      "properties": {
        "agent": { "type": "string" },
        "work_item": { "type": "string", "pattern": "^(ado:|gh:|local:)" },
        "status": { "$ref": "#/$defs/status" },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "needs_input": {
          "type": "object",
          "required": ["question"],
          "properties": {
            "question": { "type": "string", "minLength": 1 },
            "options": { "type": "array", "items": { "type": "string" } }
          }
        },
        "summary": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "needs_input" } } },
      "then": { "required": ["needs_input"] }
    },
    "shaper": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "required": ["phase"],
          "properties": {
            "agent": { "const": "shaper" },
            "phase": { "enum": ["options", "backlog"] },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title", "summary"],
                "properties": {
                  "title": { "type": "string" },
                  "summary": { "type": "string" },
                  "recommended": { "type": "boolean" },
                  "size_stories": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "chosen_option": { "type": "string" },
            "story_count": { "type": "integer", "minimum": 0 },
            "open_decisions": { "type": "array", "items": { "type": "string" } }
          },
          "if": { "properties": { "phase": { "const": "backlog" }, "status": { "const": "ok" } } },
          "then": { "required": ["chosen_option", "story_count"], "properties": { "story_count": { "minimum": 1 } } }
        }
      ]
    },
    "requirements-analyst": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "required": ["source", "acceptance_criteria_count"],
          "properties": {
            "agent": { "const": "requirements-analyst" },
            "source": { "enum": ["ado", "github", "inline"] },
            "acceptance_criteria_count": { "type": "integer", "minimum": 0 },
            "gaps": { "type": "array", "items": { "type": "string" } },
            "risk_flags": { "type": "array", "items": { "type": "string" } }
          },
          "if": { "properties": { "status": { "const": "ok" } } },
          "then": { "properties": { "acceptance_criteria_count": { "minimum": 1 } } }
        }
      ]
    },
    "planner": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "required": ["technology", "task_count", "risks"],
          "properties": {
            "agent": { "const": "planner" },
            "technology": {
              "type": "object",
              "required": ["detected", "source"],
              "properties": {
                "detected": { "type": "string" },
                "source": { "enum": ["repo", "user", "undefined"] }
              }
            },
            "task_count": { "type": "integer", "minimum": 0 },
            "acceptance_test_count": { "type": "integer", "minimum": 0 },
            "planned_paths": { "type": "array", "items": { "type": "string" } },
            "risks": { "type": "array", "items": { "type": "string" } }
          },
          "if": { "properties": { "status": { "const": "ok" } } },
          "then": {
            "required": ["planned_paths", "acceptance_test_count"],
            "properties": {
              "technology": { "properties": { "source": { "enum": ["repo", "user"] } } },
              "acceptance_test_count": { "minimum": 1 }
            }
          }
        }
      ]
    },
    "implementer": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "required": ["branch", "tasks_completed", "test_run", "ac_self_check", "fix_iteration"],
          "properties": {
            "agent": { "const": "implementer" },
            "branch": { "type": "string", "pattern": "^delivery/" },
            "tasks_completed": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
            "test_run": {
              "type": "object",
              "required": ["command", "passed", "failed"],
              "properties": {
                "command": { "type": "string" },
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 }
              }
            },
            "ac_self_check": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ac", "met", "evidence"],
                "properties": {
                  "ac": { "type": "string", "pattern": "^AC-[0-9]+$" },
                  "met": { "type": "boolean" },
                  "evidence": { "type": "string" }
                }
              }
            },
            "fix_iteration": { "type": "integer", "minimum": 0, "maximum": 5 }
          },
          "if": { "properties": { "status": { "const": "ok" } } },
          "then": { "properties": { "test_run": { "properties": { "failed": { "const": 0 } } } } }
        }
      ]
    },
    "check": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "required": ["check", "verdict", "findings"],
          "properties": {
            "agent": { "enum": ["check-requirements", "check-architecture", "check-security", "check-test-adequacy"] },
            "check": { "enum": ["requirements", "architecture", "security", "test-adequacy"] },
            "verdict": { "enum": ["pass", "fail"] },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "severity", "location", "finding", "evidence"],
                "properties": {
                  "id": { "type": "string", "pattern": "^(REQ|ARC|SEC|TST)-[0-9]+$" },
                  "severity": { "enum": ["blocking", "advisory"] },
                  "location": { "type": "string" },
                  "finding": { "type": "string" },
                  "evidence": { "type": "string" },
                  "required_action": { "type": "string" }
                },
                "if": { "properties": { "severity": { "const": "blocking" } } },
                "then": { "required": ["required_action"] }
              }
            }
          }
        }
      ]
    },
    "retro": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "required": ["lessons"],
          "properties": {
            "agent": { "const": "retro" },
            "lessons": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["observation", "agent", "proposed_change"],
                "properties": {
                  "observation": { "type": "string" },
                  "agent": { "type": "string" },
                  "proposed_change": { "type": "string" }
                }
              }
            },
            "instruction_prs": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "escalation": {
      "type": "object",
      "required": ["stage", "attempted", "blocking", "question"],
      "properties": {
        "stage": { "enum": ["shape", "intake", "plan", "gate-backlog", "gate-plan", "implement", "verify", "deliver", "gate-merge", "learn"] },
        "attempted": { "type": "string" },
        "blocking": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gate-record": {
      "description": "One line of the calibration log: what the gate recommended (sealed), what the human decided, and later the downstream outcome.",
      "type": "object",
      "required": ["gate", "work_item", "mode", "recommendation", "risk_tier", "decision", "agreed", "decided_at", "policy_version"],
      "properties": {
        "gate": { "enum": ["backlog", "plan", "merge"] },
        "work_item": { "type": "string" },
        "mode": { "enum": ["human", "shadow", "auto"] },
        "recommendation": { "enum": ["approve", "changes", "escalate"] },
        "risk_tier": { "enum": ["low", "medium", "high"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "decision": { "enum": ["approve", "changes", "reject", "auto-approved"] },
        "decided_by": { "type": "string" },
        "agreed": { "type": "boolean" },
        "outcome": { "enum": ["unknown", "kept", "reverted", "incident"] },
        "decided_at": { "type": "string" },
        "policy_version": { "type": "integer" }
      }
    }
  }
}
