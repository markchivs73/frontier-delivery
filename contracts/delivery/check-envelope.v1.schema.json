{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier:contract:frontier.delivery.check-envelope:1",
  "title": "Check agent handoff envelope",
  "description": "Returned by each of the four fresh-context check agents.",
  "x-frontier-contract": {
    "id": "frontier.delivery.check-envelope",
    "major": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "work_item",
    "status",
    "artifacts",
    "summary",
    "check",
    "verdict",
    "findings"
  ],
  "properties": {
    "agent": {
      "enum": [
        "check-requirements",
        "check-architecture",
        "check-security",
        "check-test-adequacy"
      ]
    },
    "work_item": {
      "type": "string",
      "pattern": "^(ado:|gh:|local:)"
    },
    "status": {
      "enum": [
        "ok",
        "needs_input",
        "failed"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "check": {
      "enum": [
        "requirements",
        "architecture",
        "security",
        "test-adequacy"
      ]
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "location",
          "finding",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(REQ|ARC|SEC|TST)-[0-9]+$"
          },
          "severity": {
            "enum": [
              "blocking",
              "advisory"
            ]
          },
          "location": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "required_action": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-frontier-validations": [
    {
      "rule": "self.status != 'needs_input' || has(self.needs_input)",
      "message": "needs_input is required when status is needs_input"
    },
    {
      "rule": "self.status == 'needs_input' || !has(self.needs_input)",
      "message": "needs_input is only allowed when status is needs_input"
    },
    {
      "rule": "(self.verdict == 'fail') == self.findings.exists(f, f.severity == 'blocking')",
      "message": "verdict is fail if and only if there is a blocking finding"
    },
    {
      "rule": "self.findings.all(f, f.severity != 'blocking' || (has(f.required_action) && size(f.required_action) > 0))",
      "message": "every blocking finding carries a required_action"
    },
    {
      "rule": "self.agent == 'check-' + self.check",
      "message": "agent and check must name the same lens"
    },
    {
      "rule": "self.findings.all(f, f.id.startsWith({'requirements': 'REQ-', 'architecture': 'ARC-', 'security': 'SEC-', 'test-adequacy': 'TST-'}[self.check]))",
      "message": "finding ids use the prefix of their check (REQ/ARC/SEC/TST)"
    },
    {
      "rule": "self.status != 'needs_input'",
      "message": "check agents report findings; they never block on input"
    }
  ]
}
