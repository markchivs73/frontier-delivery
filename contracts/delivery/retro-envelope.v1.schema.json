{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier:contract:frontier.delivery.retro-envelope:1",
  "title": "Retro handoff envelope",
  "description": "Returned by the learn stage after a PR is merged or closed.",
  "x-frontier-contract": {
    "id": "frontier.delivery.retro-envelope",
    "major": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "work_item",
    "status",
    "artifacts",
    "summary",
    "lessons"
  ],
  "properties": {
    "agent": {
      "const": "retro"
    },
    "work_item": {
      "type": "string",
      "pattern": "^(ado:|gh:|local:)"
    },
    "status": {
      "enum": [
        "ok",
        "needs_input",
        "failed"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation",
          "agent",
          "proposed_change"
        ],
        "properties": {
          "observation": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "proposed_change": {
            "type": "string"
          }
        }
      }
    },
    "instruction_prs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-frontier-validations": [
    {
      "rule": "self.status != 'needs_input' || has(self.needs_input)",
      "message": "needs_input is required when status is needs_input"
    },
    {
      "rule": "self.status == 'needs_input' || !has(self.needs_input)",
      "message": "needs_input is only allowed when status is needs_input"
    },
    {
      "rule": "self.lessons.all(l, !(l.agent in ['policy', 'guard', 'orchestrator-gates']))",
      "message": "retro never proposes gate-policy or guard changes; those belong to the policy owner"
    }
  ]
}
