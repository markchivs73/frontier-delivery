{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontier:contract:frontier.delivery.planner-envelope:1",
  "title": "Planner handoff envelope",
  "description": "Returned by the plan stage after writing design.md and tasks.md.",
  "x-frontier-contract": {
    "id": "frontier.delivery.planner-envelope",
    "major": 1
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "work_item",
    "status",
    "artifacts",
    "summary",
    "technology",
    "task_count",
    "risks"
  ],
  "properties": {
    "agent": {
      "const": "planner"
    },
    "work_item": {
      "type": "string",
      "pattern": "^(ado:|gh:|local:)"
    },
    "status": {
      "enum": [
        "ok",
        "needs_input",
        "failed"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected",
        "source"
      ],
      "properties": {
        "detected": {
          "type": "string"
        },
        "source": {
          "enum": [
            "repo",
            "user",
            "undefined"
          ]
        }
      }
    },
    "task_count": {
      "type": "integer",
      "minimum": 0
    },
    "acceptance_test_count": {
      "type": "integer",
      "minimum": 0
    },
    "planned_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-frontier-validations": [
    {
      "rule": "self.status != 'needs_input' || has(self.needs_input)",
      "message": "needs_input is required when status is needs_input"
    },
    {
      "rule": "self.status == 'needs_input' || !has(self.needs_input)",
      "message": "needs_input is only allowed when status is needs_input"
    },
    {
      "rule": "self.status != 'ok' || self.technology.source != 'undefined'",
      "message": "an ok plan has a defined technology (repo or user); otherwise return needs_input"
    },
    {
      "rule": "self.status != 'ok' || (has(self.acceptance_test_count) && self.acceptance_test_count >= 1)",
      "message": "an ok plan names at least one acceptance test"
    },
    {
      "rule": "self.status != 'ok' || (has(self.planned_paths) && size(self.planned_paths) >= 1)",
      "message": "an ok plan reports planned_paths (the plan gate needs them)"
    },
    {
      "rule": "self.status != 'ok' || self.task_count >= 2",
      "message": "an ok plan has T1 (acceptance tests) plus at least one more task"
    }
  ]
}
